# 把 `application-dev.yml.example` 的 `.example` 后缀去掉、密钥/配置改成自己的

sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: 123456

  jwt:
    # 密钥不应该暴露到仓库, 但练习项目可以不讲究这么多, 可以改成自己定的密钥
    admin-secret-key: itcast
    user-secret-key: itheima

  alioss:
    endpoint: <自己的endpoint>
    access-key-id: <自己的access-key-id>
    access-key-secret: <自己的access-key-secret>
    bucket-name: <自己的bucket-name>

  redis:
    host: localhost
    port: 6379
    password: 123456
    # 推荐用 0 号数据库
    database: 0

  wechat:
    appid: <自己的小程序 id>
    secret: <自己的小程序密钥>

  baidu-map:
    access-key: <自己的ak>
    url:
      geocoding: https://api.map.baidu.com/geocoding/v3
      direction: https://api.map.baidu.com/direction/v2/riding

  shop:
    address: 北京市海淀区上地十街10号
    limit-distance: 5000
