<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.EmployeeMapper">

    <!--
    完整字段, 可复用到查询完整实体对象
    -->
    <sql id="BaseColumns">
        id, name, username, password,
        phone, sex, id_number, status,
        create_time, update_time, create_user, update_user
    </sql>

    <!--
    查询员工详细信息
    -->
    <select id="selectById" resultType="com.sky.entity.Employee">
        SELECT <include refid="BaseColumns"/>
        FROM employee
        WHERE id = #{id}
    </select>

    <!--
    条件查询用户数据链表, 由 PageHelper 自动分页
    -->
    <select id="selectItemVOListByQuery" resultType="com.sky.vo.employee.EmployeePageQueryItemVO">
        SELECT id, name, username, phone, status, create_time, update_time
        FROM employee
        <where>
            <if test="query.name != null and query.name != ''">
                name like concat( '%', #{query.name}, '%' )
            </if>
        </where>
        ORDER BY create_time DESC, id DESC
    </select>

    <!--
    查询员工详情展示信息
    -->
    <select id="selectVOById" resultType="com.sky.vo.employee.EmployeeVO">
        SELECT id, name, username, phone, sex, id_number
        FROM employee
        WHERE id = #{id}
    </select>

    <!--    修改员工信息-->
    <update id="update">
        UPDATE employee
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="sex != null and sex != ''">sex = #{sex},</if>
            <if test="status != null">status = #{status},</if>
            <if test="idNumber != null and idNumber != ''">id_number = #{idNumber},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
