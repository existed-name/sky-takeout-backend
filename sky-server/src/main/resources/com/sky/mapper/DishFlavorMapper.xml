<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishFlavorMapper">

<!--    添加某种菜品对应的口味-->
    <insert id="insertBatch">
        INSERT INTO dish_flavor
        ( dish_id, name, value )
        VALUES
        <foreach collection="flavors" item="flavor" separator=",">
            ( #{flavor.dishId}, #{flavor.name}, #{flavor.value} )
        </foreach>
    </insert>

    <!--
     根据多个菜品 id 查询对应的所有菜品口味
     注: 为了匹配原来的 Dish 链表顺序，不对 DishFlavor 进行排序
    -->
    <select id="selectByDishIdList" resultType="com.sky.entity.DishFlavor">
        SELECT id, dish_id, name, value
        FROM dish_flavor
        <where>
            <include refid="com.sky.mapper.common.CommonSql.safeWhereColumnIn">
                <property name="column" value="dish_id"/>
                <property name="list" value="dishIdList"/>
            </include>
        </where>
    </select>

    <!--
    删除多个菜品对应的口味
    -->
    <delete id="deleteBatchByDishIds">
        DELETE FROM dish_flavor
        <where>
            <include refid="com.sky.mapper.common.CommonSql.safeWhereColumnIn">
                <property name="column" value="dish_id"/>
                <property name="list" value="dishIds"/>
            </include>
        </where>
    </delete>

</mapper>