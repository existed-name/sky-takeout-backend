<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <!--
    数据库表完整字段, 可供查询完整实体类复用
    -->
    <sql id="BaseColumns">
        id, setmeal_id, dish_id, name, price, copies
    </sql>

    <!--
     * 新增套餐和相关菜品的关联关系, 套餐本体信息由{@link com.sky.mapper.SetmealMapper}管理
     -->
    <insert id="insertBatch">
        INSERT INTO setmeal_dish
            ( setmeal_id, dish_id, name, price, copies )
        VALUES
            <!-- 注意 open="(" close=")" 不是每次循环生成括号，是把最终的代码包起来 -->
            <foreach collection="setmealDishes" item="relation"  separator=",">
                ( #{relation.setmealId}, #{relation.dishId}, #{relation.name}, #{relation.price}, #{relation.copies} )
            </foreach>
    </insert>

    <!--
     * 查询多个套餐对应的所有 {@link com.sky.entity.SetmealDish} 关联关系对象, 用于组装 {@link com.sky.vo.admin.setmeal.SetmealVO}
    -->
    <select id="selectBySetmealIds" resultType="com.sky.entity.SetmealDish">
        SELECT id, setmeal_id, dish_id, name, price, copies
        FROM setmeal_dish
        <where>
            <include refid="com.sky.mapper.common.CommonSql.safeWhereColumnIn">
                <property name="column" value="setmeal_id"/>
                <property name="list" value="setmealIds"/>
            </include>
        </where>
    </select>

    <!--
    查询某个套餐的关联菜品信息
    -->
    <select id="selectBySetmealId" resultType="com.sky.entity.SetmealDish">
        SELECT <include refid="BaseColumns"/>
        FROM setmeal_dish
        WHERE setmeal_id = #{setmealId}
    </select>

    <!--
    查询某个套餐包含的菜品信息
    数据项 = SetmealDish.copies + Dish.name、description、image
    排序规则: 无
    -->
    <select id="selectDishItemVOListBySetmealId" resultType="com.sky.vo.user.setmeal.UserSetmealDishItemVO">
        <!--
        先分别查出左右表需要的字段、再 JOIN
        其实并没有性能提升, 普通写法直接就可以交给优化器优化
        除非子查询需要 GROUP BY、DISTINCT、LIMIT、UNION 等等操作
        -->
        SELECT sd.copies, d.name, d.description, d.image
        FROM (
            SELECT dish_id, copies
            FROM setmeal_dish
            WHERE setmeal_id = #{setmealId}
        ) AS sd
        LEFT JOIN (
            SELECT id, name, description, image
            FROM dish
        ) AS d
        ON sd.dish_id = d.id

        <!--
        SELECT sd.copies, d.name, d.image, d.description
        FROM setmeal_dish AS sd
        LEFT JOIN dish AS d
        ON sd.dish_id = d.id
        WHERE sd.setmeal_id = #{setmealId}
        -->
    </select>

    <!--
    删除多个套餐对应的关联关系
    -->
    <delete id="deleteBySetmealIds">
        DELETE FROM setmeal_dish
        <where>
            <include refid="com.sky.mapper.common.CommonSql.safeWhereColumnIn">
                <property name="column" value="setmeal_id"/>
                <property name="list" value="setmealIds"/>
            </include>
        </where>
    </delete>

    <!--
    删除某个套餐关联的所有菜品关系
    -->
    <delete id="deleteBatchBySetmealId">
        DELETE FROM setmeal_dish
        WHERE setmeal_id = #{setmealId}
    </delete>


</mapper>