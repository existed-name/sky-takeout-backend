<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.SetmealMapper">

    <!--
    数据库表完整字段, 可供查询完整实体类复用
    -->
    <sql id="BaseColumns">
        id, category_id, name, price,
        status, description, image,
        create_time, update_time, create_user, update_user
    </sql>

    <!--
     * 批量查询菜品关联的套餐
     * <br>
     * 用于删除菜品前检查是否有关联的套餐
     -->
    <select id="countByDishIds" resultType="java.lang.Long">
        SELECT count( * )
        FROM setmeal_dish
        <where>
            dish_id IN
            <foreach collection="dishIds" item="dishId" open="(" close=")" separator=",">
                #{dishId}
            </foreach>
        </where>
    </select>

    <!--
    查询某种菜品对应的套餐
    -->
    <select id="selectIdProjectionsByDishId" resultType="com.sky.projection.setmeal.SetmealIdProjection">
        SELECT id, category_id
        FROM setmeal
        WHERE id IN (
            SELECT setmeal_id
            FROM setmeal_dish
            WHERE dish_id = #{dishId}
        )
    </select>

    <!--
     * 修改多个套餐的状态
     * <br>
     * 本来想 SET 应该不能像 VALUES 那样设置多条不同值，然后 AI 提醒还可以用 CASE-WHEN，这样就可以每个对象单独设置自己的 status 了
     -->
    <update id="updateBatchStatusByIds">
        <!-- 没有几年功力真的写得出来 AI 这种代码嘛😂 -->
        UPDATE setmeal
        SET status = CASE id
            <foreach collection="setmealList" item="setmeal">
                WHEN #{setmeal.id} THEN #{setmeal.status}
            </foreach>
        END,
        <!-- AI 补充: 可以直接 NOW()，不依赖对象、减少 Java 侧计算 -->
        update_time = #{setmealList[0].updateTime},
        update_user = #{setmealList[0].updateUser}
        WHERE id IN
        <foreach collection="setmealList" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>

        <!-- 效果示例, 也就是说，复杂 SQL 可以用示例倒推代码
        UPDATE setmeal
        SET status = CASE id
            WHEN 1 THEN 0      - id=1 的，status 改成 0
            WHEN 2 THEN 1      - id=2 的，status 改成 1
            WHEN 3 THEN 0      - id=3 的，status 改成 0
        END,                   - CASE 结束
        update_time = 'xx',    ← setmealList[0].updateTime
        update_user = 1
        WHERE id IN (1, 2, 3)  - 只更新这 3 行
        -->
    </update>

    <!--
     * 条件分页查询 - PageHelper 负责分页
     *
     * @return 套餐本体的部分字段 + 分类名称, <B>不包含关联对象{@link com.sky.entity.SetmealDish}(由调用方选择性拼装)</B>
    -->
    <select id="selectItemVOByQueryWithoutSetmealDishRelation" resultType="com.sky.vo.setmeal.SetmealPageQueryItemVO">
        SELECT s.id, s.category_id, s.name, s.price, s.status, s.image, s.update_time
            , c.name AS categoryName
        FROM (
            SELECT id, category_id, name, price, status, image, update_time
            FROM setmeal
            <where>
                <if test="query.name != null and query.name.trim() != ''">AND name LIKE concat( '%', #{query.name}, '%' ) </if>
                <if test="query.categoryId != null">AND category_id = #{query.categoryId} </if>
                <if test="query.status != null">AND status = #{query.status} </if>
            </where>
        ) AS s
        LEFT JOIN category AS c
        ON s.category_id = c.id
    </select>

    <!--
    批量删除套餐
    -->
    <delete id="deleteByIds">
        DELETE FROM setmeal
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <!--
    批量查询套餐, 用于批量删除套餐之前检查套餐状态
    -->
    <select id="selectByIds" resultType="com.sky.entity.Setmeal">
        SELECT id, category_id, name, price, status, description, image, create_time, update_time, create_user, update_user
        FROM setmeal
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

    <!--
    根据 id 查询套餐 VO,
    包含 Setmeal + CategoryName,
    关联关系 com.sky.entity.SetmealDish 由业务层单独查询再组装 VO
    -->
    <select id="selectInfoVOByIdWithoutSetmealDishRelation" resultType="com.sky.vo.setmeal.SetmealInfoVO">
        SELECT s.id, s.category_id, s.name, s.price, s.status, s.description, s.image
            , c.name AS categoryName
        FROM (
            SELECT id, category_id, name, price, status, description, image
            FROM setmeal
            WHERE id = #{id}
        ) AS s
        LEFT JOIN category AS c
        ON s.category_id = c.id
    </select>

    <!--
     * 修改套餐信息
     * <br>
     * 注意: <b>仅修改 {@link com.sky.entity.Setmeal}</b>, 关联关系 {@link com.sky.entity.SetmealDish} 由 {@link com.sky.mapper.SetmealDishMapper} 负责
    -->
    <update id="updateById">
        UPDATE setmeal
        <set>
            <if test="setmeal.categoryId != null">category_id = #{setmeal.categoryId}, </if>
            <if test="setmeal.name != null and setmeal.name.trim() != ''">name = #{setmeal.name}, </if>
            <if test="setmeal.price != null">price = #{setmeal.price}, </if>
            <if test="setmeal.status != null">status = #{setmeal.status}, </if>
            <if test="setmeal.description != null and setmeal.description.trim() != ''">description = #{setmeal.description}, </if>
            <if test="setmeal.image != null and setmeal.image.trim() != ''">image = #{setmeal.image}, </if>
            update_time = #{setmeal.updateTime},
            update_user = #{setmeal.updateUser}
        </set>
        WHERE id = #{setmeal.id}
    </update>

    <!--
     * 根据套餐分类 id 查询对应的套餐 VO = setmeal + categoryName
     *     <b>不包含套餐-菜品关联关系</b>
     按修改时间降序，修改时间相同按照 id 降序
    -->
    <select id="selectSetmealVOByCategoryIdWithoutSetmealDishRelation" resultType="com.sky.vo.SetmealVO">
        SELECT s.id, s.category_id, s.name, s.price, s.status, s.description, s.image, s.create_time, s.update_time, s.create_user, s.update_user
                , c.name AS categoryName
        FROM setmeal AS s
        LEFT JOIN category AS c
        ON s.category_id = c.id
        <where>
            <if test="categoryId != null">s.category_id = #{categoryId}</if>
        </where>
        ORDER BY s.update_time DESC, s.id DESC
    </select>

    <!--
    根据套餐分类 id、起售状态查询对应的套餐数据项
    按修改时间降序排列，修改时间相同按照 id 降序排列
    @return 套餐数据项列表, <b>不包含关联菜品信息、分类名称</b>
     -->
    <select id="listItemVOsByCategoryIdAndStatusWithoutRelation" resultType="com.sky.vo.user.setmeal.UserSetmealListItemVO">
        SELECT s.id, s.category_id, s.name, s.price, s.description, s.image
        FROM setmeal AS s
        <where>
            AND s.category_id = #{categoryId}
            AND s.status = #{status}
        </where>
        ORDER BY s.update_time DESC, s.id DESC

        <!--
        TODO: 如果需要展示该套餐的分类名称, 则替换为下面的 SQL
        SELECT s.id, s.category_id, s.name, s.price, s.description, s.image
                , c.name AS categoryName
        FROM (
            SELECT id, category_id, name, price, status, description, image, update_time
            FROM setmeal
            WHERE category_id = #{categoryId}
                    AND status = #{status}
        ) AS s
        LEFT JOIN category AS c
        ON s.category_id = c.id
        ORDER BY s.update_time DESC, s.id DESC
        -->
    </select>

    <!--
    统计一批套餐里面、某种售卖状态的套餐数量
    -->
    <select id="countByIdsAndStatus" resultType="java.lang.Long">
        SELECT count( * )
        FROM setmeal
        WHERE status = #{status}
            AND id IN
                <foreach collection="ids" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
    </select>

    <!--
    统计一批 id 对应存在的数据条数, 用于和 idList 长度比较判断是否有数据被删除或不存在
    -->
    <select id="countByIds" resultType="java.lang.Long">
        SELECT count( * )
        FROM setmeal
        WHERE id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
    </select>

    <!--
    查询一批套餐所属的分类 id
    -->
    <select id="selectCategoryIdsByIds" resultType="java.lang.Long">
        SELECT category_id
        FROM setmeal
        WHERE id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                id
            </foreach>
    </select>

</mapper>