<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishMapper">

    <!--
    数据库表完整字段, 可供查询完整实体类复用
    -->
    <sql id="BaseColumns">
        id, name, category_id, price,
        image, description, status,
        create_time, update_time, create_user, update_user
    </sql>

    <!--
     * 条件分页查询 - PageHelper 执行分页操作
     * <br>
     * 联表查询 Dish + CategoryName，之后单独查 DishFlavorList，再业务层拼装 DishVOList
     * <br>
     * 排序规则: 菜品修改时间降序、菜品 id 降序
    -->
    <select id="selectItemVOByQueryWithoutFlavors" resultType="com.sky.vo.dish.DishPageQueryItemVO">

        SELECT d.id, d.category_id, d.name, d.price, d.image, d.description, d.status, d.update_time
            , c.name AS categoryName
            <!-- 注意 category 的 name 字段取别名为 VO 对象的属性，让 Mybatis 能够识别、封装 -->
        FROM (
            SELECT id, category_id, name, price, image, description, status, update_time
            FROM dish
            <where>
                <!-- 注意字段全部带上表别名来限定，防止数据库认为字段模糊 -->
                <if test="query.name != null and query.name.trim() != ''">AND name LIKE concat( '%', #{query.name}, '%' )</if>
                <if test="query.categoryId != null">AND category_id = #{query.categoryId}</if>
                <if test="query.status != null">AND status = #{query.status}</if>
            </where>
        ) AS d
        LEFT JOIN category AS c
        ON d.category_id = c.id
        ORDER BY d.update_time DESC, d.id DESC

    </select>

    <!--
         * 批量查询某种状态的菜品数量(比如正在起售的菜品数量)
         * <br>
         * 用于删除菜品前检查是否起售
         * <br>
         * 更推荐 java.lang.Long，因为 count(*) 在 MySQL 里默认返回 BIGINT
    -->
    <select id="countByIdsAndStatus" resultType="java.lang.Long">
        SELECT count( * )
        FROM dish
        <where>
            status = #{status}
            AND id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
        </where>
    </select>

    <!--
    批量删除菜品
    -->
    <delete id="deleteBatch">
        DELETE FROM dish
        <where>
            id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
        </where>
    </delete>

    <!--
     * 根据 id 查询菜品信息
     * <br>
     * DishVO = Dish + CategoryName + DishFlavorList, 这里只查 Dish、CategoryName，之后单独查 DishFlavor 在业务层组装
     -->
    <select id="selectVOByIdWithoutFlavors" resultType="com.sky.vo.DishVO">
        SELECT d.id, d.category_id, d.name, d.price, d.image, d.description
            , c.name AS categoryName
        <!-- 注意 category 的 name 字段取别名为 VO 对象的属性，让 Mybatis 能够识别、封装 -->
        FROM (
            SELECT id, category_id, name, price, image, description
            FROM dish
            WHERE id = #{id}
        ) AS d
        LEFT JOIN category AS c
        ON d.category_id = c.id
    </select>

    <!--
    修改菜品信息
    -->
    <update id="update">
        UPDATE dish
        <set>
            <if test="dish.name != null and dish.name.trim() != ''">name = #{dish.name}, </if>
            <if test="dish.categoryId != null">category_id = #{dish.categoryId}, </if>
            <if test="dish.price != null">price = #{dish.price}, </if>
            <if test="dish.image != null and dish.image.trim() != ''">image = #{dish.image}, </if>
            <if test="dish.description != null and dish.description.trim() !=''">description = #{dish.description}, </if>
            <if test="dish.status != null">status = #{dish.status}, </if>
            <if test="dish.updateTime != null">update_time = #{dish.updateTime}, </if>
            <if test="dish.updateUser != null">update_user = #{dish.updateUser}, </if>
        </set>
        WHERE id = #{dish.id}
    </update>

    <!--
    切换菜品状态(停售/起售)
    -->
    <update id="updateStatusById">
        UPDATE dish
        <!-- 由于修改字段确定，这里就不 if 判空 -->
        SET status = #{dish.status},
            update_time = #{dish.updateTime},
            update_user = #{dish.updateUser}
        WHERE id = #{dish.id}
    </update>

    <!--
     * 根据分类 id 查询菜品
     * 按照修改时间降序排列，修改时间相同按照 id 降序
     * @return 参数为空，查到所有菜品；参数无效则查询为空
     -->
    <select id="listItemVOsByCategoryIdWithoutFlavors" resultType="com.sky.vo.dish.DishListItemVO">
        SELECT d.id, d.name, d.category_id, d.price, d.status
        FROM dish AS d
        <where>
            <if test="categoryId != null">d.category_id = #{categoryId}</if>
        </where>
        ORDER BY d.update_time DESC, d.id DESC
    </select>

    <!--
    根据菜品分类、起售状态查询菜品( 不包含菜品口味、分类名称 )
    按照修改时间降序排列，修改时间相同按照 id 降序
    -->
    <select id="listItemVOsByCategoryIdAndStatusWithoutFlavors" resultType="com.sky.vo.user.dish.UserDishListItemVO">
        SELECT id, category_id, name, price, image, description
        FROM dish
        WHERE category_id = #{categoryId} AND status = #{status}
        ORDER BY update_time DESC, id DESC
        <!--
        TODO: 如果需要展示该菜品的分类名称, 则替换为下面的 SQL
        SELECT d.id, d.category_id, d.name, d.price, d.image, d.description
                , c.name AS categoryName
        FROM (
            SELECT id, category_id, name, price, image, description, update_time
            FROM dish
            WHERE category_id = #{categoryId} AND status = #{status}
        ) AS d
        LEFT JOIN category AS c
        ON d.category_id = c.id

        注意如果在联表前排序, 表格合并时会丢失原来的排序, 应该在最后来排序
        ORDER BY d.update_time DESC, d.id DESC
        -->
    </select>

    <!--
    根据 id 批量查询菜品分类 id, 用于组装 RedisKey = 业务前缀:分类 id
    Returns: 只包含 categoryId 的 DishList
    -->
    <select id="selectCategoryIdsByIds" resultType="java.lang.Long">
        SELECT category_id
        FROM dish
        WHERE id IN
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            id
        </foreach>
    </select>

    <!--
    查询不包含审计字段的 Dishes
    -->
    <select id="selectPartsByIds" resultType="com.sky.entity.Dish">
        SELECT id, name, category_id, price, image, description, status
        FROM dish
        WHERE id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
    </select>

    <!--
    统计一批 id 对应存在的数据条数, 用于和 idList 长度比较判断是否有数据被删除或不存在
    -->
    <select id="countByIds" resultType="java.lang.Long">
        SELECT count( * )
        FROM dish
        WHERE id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
    </select>

    <!--
    统计某个套餐包含的某种状态的菜品数量, 比如 1 个套餐包含了多少个停售的菜品( 用于判断是否可以起售套餐 )
    -->
    <select id="countBySetmealIdAndStatus" resultType="java.lang.Long">
        SELECT count( * )
        FROM dish
        WHERE status = #{status}
            AND id IN (
                <!--
                这里子查询返回 0 行数据会自动判为 false
                只有手动传入链表才可能出现空的 in 括号
                -->
                SELECT dish_id
                FROM setmeal_dish
                WHERE setmeal_id = #{setmealId}
            )
    </select>

    <!--
     * 查询某个菜品
     *
     * @param id 菜品 id
     * @return <b>字段完整</b>的实体对象, <b>不存在时返回 null</b>
    -->
    <select id="selectById" resultType="com.sky.entity.Dish">
        SELECT <include refid="BaseColumns"/>
        FROM dish
        WHERE id = #{id}
    </select>

    <!--
     * 查询某个菜品的部分字段, 用于组装购物车数据
     *
     * @param id 菜品 id
     * @return 菜品对象部分字段, <b>不存在时返回 null</b>
    -->
    <select id="selectShoppingCartProjectionById" resultType="com.sky.projection.dish.DishShoppingCartProjection">
        SELECT name, price, image
        FROM dish
        WHERE id = #{id}
    </select>

</mapper>