<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.OrderMapper">

    <!--
    所有字段，可复用到查完整 order 对象
    -->
    <sql id="BaseColumns">
        id, number, status, user_id, address_book_id, order_time, checkout_time,
        pay_method, pay_status, amount, remark, user_name, phone, address, consignee,
        cancel_reason, rejection_reason, cancel_time, estimated_delivery_time,
        delivery_status, delivery_time, pack_amount, tableware_number, tableware_status
    </sql>

    <!--
    根据 id、userId 修改订单信息, 修改前会对传入对象的字段判空
    -->
    <update id="updateByIdAndUserId">
        <!--
        从所有的字段挑选出
            status, checkout_time, pay_status, cancel_reason,
            cancel_time, rejection_reason, delivery_time
        可多处复用
        -->
        UPDATE orders
        <set>
            <if test="order.status != null">
                status = #{order.status},
            </if>
            <if test="order.checkoutTime != null">
                checkout_time = #{order.checkoutTime},
            </if>
            <if test="order.payStatus != null">
                pay_status = #{order.payStatus},
            </if>
            <if test="order.cancelReason != null and order.cancelReason.trim() !='' ">
                cancel_reason = #{order.cancelReason},
            </if>
            <if test="order.cancelTime != null">
                cancel_time = #{order.cancelTime},
            </if>
            <if test="order.rejectionReason != null and order.rejectionReason.trim() !='' ">
                rejection_reason = #{order.rejectionReason},
            </if>
            <!-- 之前多写了 pay_method 已删 -->
            <if test="order.deliveryTime != null">
                delivery_time = #{order.deliveryTime}
            </if>
        </set>
        WHERE id = #{order.id} AND user_id = #{order.userId}
    </update>

    <!--
    管理端更新订单信息
    -->
    <update id="updateById">
        <!--
        从所有的字段挑选出
            status, pay_status, cancel_reason,
            cancel_time, rejection_reason, delivery_time
        可多处复用
        -->
        UPDATE orders
        <set>
            <if test="order.status != null">
                status = #{order.status},
            </if>
            <if test="order.payStatus != null">
                pay_status = #{order.payStatus},
            </if>
            <if test="order.cancelReason != null and order.cancelReason.trim() !='' ">
                cancel_reason = #{order.cancelReason},
            </if>
            <if test="order.cancelTime != null">
                cancel_time = #{order.cancelTime},
            </if>
            <if test="order.rejectionReason != null and order.rejectionReason.trim() !='' ">
                rejection_reason = #{order.rejectionReason},
            </if>
            <if test="order.deliveryTime != null">
                delivery_time = #{order.deliveryTime}
            </if>
        </set>
        WHERE id = #{order.id}
    </update>

    <!--
    批量更新订单
    -->
    <update id="updateBatchByIds">
        UPDATE orders

        SET status = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.status != null">
                        #{order.status}
                    </when>
                    <otherwise>
                        status
                    </otherwise>
                </choose>
            </foreach>
            ELSE status
        END,

        <!--
        实际拼接情况
        SET status = CASE id
            WHEN 4 THEN 6
            WHEN 5 THEN 6
            WHEN ...
            ELSE status  兜底处理没有枚举到的情况
        END,
        -->

        pay_status = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.payStatus != null">
                        #{order.payStatus}
                    </when>
                    <otherwise>
                        pay_status
                    </otherwise>
                </choose>
            </foreach>
            ELSE pay_status
        END,

        cancel_reason = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.cancelReason != null and order.cancelReason.trim() != ''">
                        #{order.cancelReason}
                    </when>
                    <otherwise>
                        cancel_reason
                    </otherwise>
                </choose>
            </foreach>
            ELSE cancel_reason
        END,

        cancel_time = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.cancelTime != null">
                        #{order.cancelTime}
                    </when>
                    <otherwise>
                        cancel_time
                    </otherwise>
                </choose>
            </foreach>
            ELSE cancel_time
        END,

        rejection_reason = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.rejectionReason != null and order.rejectionReason.trim() != ''">
                        #{order.rejectionReason}
                    </when>
                    <otherwise>
                        rejection_reason
                    </otherwise>
                </choose>
            </foreach>
            ELSE rejection_reason
        END,

        delivery_time = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.deliveryTime != null">
                        #{order.deliveryTime}
                    </when>
                    <otherwise>
                        delivery_time
                    </otherwise>
                </choose>
            </foreach>
            ELSE delivery_time
        END

        WHERE id IN
            <foreach collection="orders" item="order" open="(" separator="," close=")">
                #{order.id}
            </foreach>
    </update>

    <!--
    条件查询该用户的历史订单 VO, 分页操作由com.sky.utils.PageUtil完成
    排序规则: 按照时间降序排列、时间相同按照 id 倒序排列，确保用户看到最新订单
    -->
    <select id="selectByUserIdAndQuery" resultType="com.sky.vo.order.OrderHistoryItemVO">
        SELECT id, status, order_time, amount
        FROM orders
        <where>
            user_id = #{userId}
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY order_time DESC, id DESC
    </select>

    <!--
    查询完整订单实体类
    -->
    <select id="selectByIdAndUserId" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns" />
        FROM orders
        WHERE id = #{id} AND user_id = #{userId}
    </select>

    <!--
    管理端条件查询订单, 分页操作由com.sky.utils.PageUtil完成
    排序规则: 按照下单时间降序排列、时间相同按照 id 倒序排列，管理端优先看最新订单
    Returns: 完整的订单对象列表
    -->
    <select id="selectByQuery" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns"/>
        FROM orders
        <where>
            <if test="query.beginTime != null">
                <!-- greater than -->
                AND order_time &gt;= #{query.beginTime}
            </if>
            <if test="query.endTime != null">
                <!-- less than -->
                AND order_time &lt;= #{query.endTime}
            </if>
            <if test="query.number != null and query.number.trim() != ''">
                AND number LIKE concat( '%', #{query.number}, '%' )
            </if>
            <if test="query.phone != null and query.phone.trim() != ''">
                AND phone LIKE concat( '%', #{query.phone}, '%' )
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY order_time DESC, id DESC
    </select>

    <!--
    管理端查询某个订单实体对象
    -->
    <select id="selectById" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns"/>
        FROM orders
        WHERE id = #{id}
    </select>

    <!--
    统计指定时间范围内, 每天的总营业额
    只查询已完成、没被取消的订单
    -->
    <select id="sumAmountByStatusAndGroupByDate" resultType="com.sky.vo.report.TurnoverReportItemVO">
        SELECT date( checkout_time ) AS date, sum( amount ) AS turnover
        FROM orders
        WHERE status = #{status} AND
            #{begin} &lt;= checkout_time AND
            checkout_time &lt; #{endExclusive}
        GROUP BY date( checkout_time )
        <!--
        日期比较,
        '2026-09-17' 字符串会自动补全时间 = '2026-09-17 00:00:00'
        常量日期必须加单引号, 否则 2026-09-17 会解析成 2000 数字
        但 #{...} 无需加引号, where ? <= checkout_time 可以直接把参数设置进去
        -->
    </select>

    <!--
    统计指定时间范围内的总营业额
    -->
    <select id="sumAmountByStatusAndDateRange" resultType="java.math.BigDecimal">
        SELECT sum( amount )
        FROM orders
        WHERE status = #{status}
            AND #{begin} &lt;= checkout_time
            AND checkout_time &lt; #{endExclusive}
    </select>

    <!--
    统计指定时间范围内, 每天的订单数量
    -->
    <select id="countGroupByDate" resultType="com.sky.vo.report.OrderCountItemVO">
        SELECT date( order_time ) AS date, count( * ) AS count
        FROM orders
        WHERE #{begin} &lt;= order_time AND
            order_time &lt; #{endExclusive}
        GROUP BY date( order_time )
    </select>

    <!--
    统计时间范围内, 每天某种状态的订单数
    -->
    <select id="countByStatusAndGroupByDate" resultType="com.sky.vo.report.OrderValidCountItemVO">
        SELECT date( order_time ) AS date, count( * ) AS count
        FROM orders
        WHERE status = #{status} AND
            #{begin} &lt;= order_time AND
            order_time &lt; #{endExclusive}
        GROUP BY date( order_time )
    </select>

    <!--
    统计指定时间范围内, 某种状态的订单数
    -->
    <select id="countByStatusAndDateRange" resultType="java.lang.Long">
        SELECT count( * )
        FROM orders
        WHERE status = #{status} AND
            #{begin} &lt;= order_time AND
            order_time &lt; #{endExclusive}
    </select>

    <!--
    计算时间范围内, 某种状态的订单占该时间段总订单的比率
    -->
    <select id="calcRateByStatusAndGroupByDate" resultType="com.sky.dto.report.OrderCompletionRateItem">
        <!--
            * SQL 思路
            * 分别写出计算分子、分母的 SQL
            * 然后写出计算目标值的 SQL
            * 有了 3 个部分, 看出规律, 就把内部分子、分母作为子表、联合
            * 最后再考虑怎么保留小数位数
        -->
        SELECT round( statusCount / totalCount, #{scale} )
        FROM (
            (
                SELECT count( * ) AS statusCount
                FROM orders
                WHERE status = #{status} AND
                    #{begin} &lt;= order_time AND
                    order_time &lt; #{endExclusive}
            ) AS status_count
            INNER JOIN (
                SELECT count( * ) AS totalCount
                FROM orders
                WHERE #{begin} &lt;= order_time AND
                    order_time &lt; #{endExclusive}
            ) AS total_count
        )
        <!--
        AS temp
        注意这里 FROM 不需要给表设置别名, FROM 里面已经设好别名了
        -->
    </select>

    <!--
    计算指定时间范围内, 每天的平均客单价
    -->
    <select id="calcUnitPriceByStatusAndGroupByDate" resultType="com.sky.dto.report.UnitPriceItem">
        <!--
            * 拆分部分、再组合
            * 每天的营业额
            * 每天的有效订单数
            * 根据日期合并营业额、有效订单数 2 个表
            * 计算平均客单价
            * 保留小数位数
            * 并且发现营业额、有效订单数的查询条件完全一样, 于是直接合并结构, 取消联表
        -->
        SELECT date AS date,
            round( dailyTurnover / dailyValidCount, #{scale} ) AS unitPrice
        FROM (
            SELECT date( order_time ) AS date,
                sum( amount ) AS dailyTurnover,
                count( * ) AS dailyValidCount
            FROM orders
            WHERE status = #{status} AND
                #{begin} &lt;= order_time AND
                order_time &lt; #{endExclusive}
            GROUP BY date( order_time )
        ) AS temp
    </select>

</mapper>