<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.OrderMapper">

    <!--
    所有字段，可复用到查完整 order 对象
    -->
    <sql id="BaseColumns">
        id, number, status, user_id, address_book_id, order_time, checkout_time,
        pay_method, pay_status, amount, remark, user_name, phone, address, consignee,
        cancel_reason, rejection_reason, cancel_time, estimated_delivery_time,
        delivery_status, delivery_time, pack_amount, tableware_number, tableware_status
    </sql>

    <!--
    根据 id、userId 修改订单信息, 修改前会对传入对象的字段判空
    -->
    <update id="updateByIdAndUserId">
        <!--
        从所有的字段挑选出
            status, checkout_time, pay_status, cancel_reason,
            cancel_time, rejection_reason, delivery_time
        可多处复用
        -->
        UPDATE orders
        <set>
            <if test="order.status != null">
                status = #{order.status},
            </if>
            <if test="order.checkoutTime != null">
                checkout_time = #{order.checkoutTime},
            </if>
            <if test="order.payStatus != null">
                pay_status = #{order.payStatus},
            </if>
            <if test="order.cancelReason != null and order.cancelReason.trim() !='' ">
                cancel_reason = #{order.cancelReason},
            </if>
            <if test="order.cancelTime != null">
                cancel_time = #{order.cancelTime},
            </if>
            <if test="order.rejectionReason != null and order.rejectionReason.trim() !='' ">
                rejection_reason = #{order.rejectionReason},
            </if>
            <!-- 之前多写了 pay_method 已删 -->
            <if test="order.deliveryTime != null">
                delivery_time = #{order.deliveryTime}
            </if>
        </set>
        WHERE id = #{order.id} AND user_id = #{order.userId}
    </update>

    <!--
    管理端更新订单信息
    -->
    <update id="updateById">
        <!--
        从所有的字段挑选出
            status, pay_status, cancel_reason,
            cancel_time, rejection_reason, delivery_time
        可多处复用
        -->
        UPDATE orders
        <set>
            <if test="order.status != null">
                status = #{order.status},
            </if>
            <if test="order.payStatus != null">
                pay_status = #{order.payStatus},
            </if>
            <if test="order.cancelReason != null and order.cancelReason.trim() !='' ">
                cancel_reason = #{order.cancelReason},
            </if>
            <if test="order.cancelTime != null">
                cancel_time = #{order.cancelTime},
            </if>
            <if test="order.rejectionReason != null and order.rejectionReason.trim() !='' ">
                rejection_reason = #{order.rejectionReason},
            </if>
            <if test="order.deliveryTime != null">
                delivery_time = #{order.deliveryTime}
            </if>
        </set>
        WHERE id = #{order.id}
    </update>

    <!--
    批量更新订单
    -->
    <update id="updateBatchByIds">
        UPDATE orders

        SET status = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.status != null">
                        #{order.status}
                    </when>
                    <otherwise>
                        status
                    </otherwise>
                </choose>
            </foreach>
            ELSE status
        END,

        <!--
        实际拼接情况
        SET status = CASE id
            WHEN 4 THEN 6
            WHEN 5 THEN 6
            WHEN ...
            ELSE status  兜底处理没有枚举到的情况
        END,
        -->

        pay_status = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.payStatus != null">
                        #{order.payStatus}
                    </when>
                    <otherwise>
                        pay_status
                    </otherwise>
                </choose>
            </foreach>
            ELSE pay_status
        END,

        cancel_reason = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.cancelReason != null and order.cancelReason.trim() != ''">
                        #{order.cancelReason}
                    </when>
                    <otherwise>
                        cancel_reason
                    </otherwise>
                </choose>
            </foreach>
            ELSE cancel_reason
        END,

        cancel_time = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.cancelTime != null">
                        #{order.cancelTime}
                    </when>
                    <otherwise>
                        cancel_time
                    </otherwise>
                </choose>
            </foreach>
            ELSE cancel_time
        END,

        rejection_reason = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.rejectionReason != null and order.rejectionReason.trim() != ''">
                        #{order.rejectionReason}
                    </when>
                    <otherwise>
                        rejection_reason
                    </otherwise>
                </choose>
            </foreach>
            ELSE rejection_reason
        END,

        delivery_time = CASE id
            <foreach collection="orders" item="order">
                WHEN #{order.id} THEN
                <choose>
                    <when test="order.deliveryTime != null">
                        #{order.deliveryTime}
                    </when>
                    <otherwise>
                        delivery_time
                    </otherwise>
                </choose>
            </foreach>
            ELSE delivery_time
        END

        WHERE id IN
            <foreach collection="orders" item="order" open="(" separator="," close=")">
                #{order.id}
            </foreach>
    </update>

    <!--
    条件查询该用户的历史订单 VO, 分页操作由com.sky.utils.PageUtil完成
    排序规则: 按照时间降序排列、时间相同按照 id 倒序排列，确保用户看到最新订单
    -->
    <select id="selectByUserIdAndQuery" resultType="com.sky.vo.order.OrderHistoryItemVO">
        SELECT id, status, order_time, amount
        FROM orders
        <where>
            user_id = #{userId}
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY order_time DESC, id DESC
    </select>

    <!--
    查询完整订单实体类
    -->
    <select id="selectByIdAndUserId" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns" />
        FROM orders
        WHERE id = #{id} AND user_id = #{userId}
    </select>

    <!--
    管理端条件查询订单, 分页操作由com.sky.utils.PageUtil完成
    排序规则: 按照下单时间降序排列、时间相同按照 id 倒序排列，管理端优先看最新订单
    Returns: 完整的订单对象列表
    -->
    <select id="selectByQuery" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns"/>
        FROM orders
        <where>
            <if test="query.beginTime != null">
                <!-- greater than -->
                AND order_time &gt;= #{query.beginTime}
            </if>
            <if test="query.endTime != null">
                <!-- less than -->
                AND order_time &lt;= #{query.endTime}
            </if>
            <if test="query.number != null and query.number.trim() != ''">
                AND number LIKE concat( '%', #{query.number}, '%' )
            </if>
            <if test="query.phone != null and query.phone.trim() != ''">
                AND phone LIKE concat( '%', #{query.phone}, '%' )
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY order_time DESC, id DESC
    </select>

    <!--
    管理端查询某个订单实体对象
    -->
    <select id="selectById" resultType="com.sky.entity.Orders">
        SELECT <include refid="BaseColumns"/>
        FROM orders
        WHERE id = #{id}
    </select>

</mapper>